include $(SRCDIR)/config/aros.cfg

CATALOGS := basque catalan croatian czech danish dutch \
    finnish french german hungarian italian norwegian \
    polish portuguese russian serbian spanish swedish \
    turkish

%build_catalogs mmake=kernel-security-catalogs \
    catalogs=$(CATALOGS) description=$(SRCDIR)/$(CURDIR)/security \
    name=Security subdir=System
